; =================== Installation ===================
;[1]
[USB_Install1]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install2]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install3]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install4]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install5]
Include=winusb.inf
Needs=WINUSB.NT

;[2]
[USB_Install1.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install2.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install3.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install4.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install5.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

;[3]
[USB_Install1.Wdf]
KmdfService=WINUSB,WinUSB_Install

[USB_Install2.Wdf]
KmdfService=WINUSB,WinUSB_Install

[USB_Install3.Wdf]
KmdfService=WINUSB,WinUSB_Install

[USB_Install4.Wdf]
KmdfService=WINUSB,WinUSB_Install

[USB_Install5.Wdf]
KmdfService=WINUSB,WinUSB_Install

[WinUSB_Install]
KmdfLibraryVersion=1.9

;[4]
[USB_Install1.HW]
AddReg=Dev_AddReg1

[USB_Install2.HW]
AddReg=Dev_AddReg2

[USB_Install3.HW]
AddReg=Dev_AddReg3

[USB_Install4.HW]
AddReg=Dev_AddReg4

[USB_Install5.HW]
AddReg=Dev_AddReg5

[Dev_AddReg1]
HKR,,DeviceInterfaceGUIDs,0x10000,"{803557FA-2AE7-4Df3-B413-C6075A41dd99}"

[Dev_AddReg2]
HKR,,DeviceInterfaceGUIDs,0x10000,"{1F4911F2-C55D-4561-987A-BCFA74D5BB6D}"

[Dev_AddReg3]
HKR,,DeviceInterfaceGUIDs,0x10000,"{CDB3B5AD-293B-4663-AA36-1AAE46463776}"

[Dev_AddReg4]
HKR,,DeviceInterfaceGUIDs,0x10000,"{9B90BC89-924B-4A36-9ECF-C2608D70BF9C}"

[Dev_AddReg5]
HKR,,DeviceInterfaceGUIDs,0x10000,"{304FBE3C-B5FE-401D-AF5A-764FFDC291EF}"

;[5]
[USB_Install1.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[USB_Install2.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[USB_Install3.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[USB_Install4.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[USB_Install5.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[CoInstallers_AddReg]
HKR,,CoInstallers32,0x00010000,"WdfCoInstaller01009.dll,WdfCoInstaller","WinUSBCoInstaller2.dll"

[CoInstallers_CopyFiles]
WinUSBCoInstaller2.dll
WdfCoInstaller01009.dll

[DestinationDirs]
CoInstallers_CopyFiles=11

; ================= Source Media Section =====================
[SourceDisksNames]
1=%DISK_NAME%,,,\i386
2=%DISK_NAME%,,,\amd64
3=%DISK_NAME%,,,\ia64

[SourceDisksFiles.x86]
WinUSBCoInstaller2.dll=1
WdfCoInstaller01009.dll=1

[SourceDisksFiles.amd64]
WinUSBCoInstaller2.dll=2
WdfCoInstaller01009.dll=2

[SourceDisksFiles.ia64]
WinUSBCoInstaller2.dll=3
WdfCoInstaller01009.dll=3

